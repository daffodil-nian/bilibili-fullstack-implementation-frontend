<!--
  SystemTip.vue · 群系统消息
  ------------------------------------------------------------
  用法（在 ChatWindow/index.vue 的消息循环里）：
    <SystemTip v-if="m.type === 100" :content="m.content || ''" />
    <MsgBubble v-else ... />

  样式：居中灰色小字，无头像、无气泡尾巴、不可撤回
  这就是你之前建的空文件 components/chat/SystemTip.vue 的正式实现
-->
<script setup lang="ts">
defineProps<{
  content: string
  /** 可选：显示在文字后面的时间 */
  time?: string
}>()
</script>

<template>
  <div class="system-tip">
    <span class="txt">{{ content }}</span>
    <span v-if="time" class="t">{{ time }}</span>
  </div>
</template>

